# User uploads are data, never code: don't run scripts from this folder.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<FilesMatch "\.(?i:php\d*|phtml|phar|pht|phps|cgi|pl|py|sh|htaccess)$">
    Require all denied
</FilesMatch>
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .phar
RemoveType .php .phtml .phar
